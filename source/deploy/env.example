# rdc.env — RDC app-in TAM parametr siyahısı (PR #298)
#
# BU FAYL ŞABLONDUR — laptopda kopyasını yaradın:
#   cp deploy/env.example deploy/rdc.env
# və parolları orada doldurun. deploy/rdc.env .gitignore-dadır — GIT-Ə GETMİR.
#
# İşəsalma (laptopdan, 1 əmr):
#   bash deploy/run-remote.sh user@server
# → rdc.env şifrələnmiş ssh kanalı ilə birbaşa prosesin env-inə ötürülür:
#   serverdə heç bir fayla yazılmır, bash_history-yə düşmür.
#
# Format: KEY=value (export sözü YAZILMIR). Dəyişiklikdən sonra yenidən
# run-remote.sh işlədin (restart avtomatik olur).

# ==================== Database ====================
DB_HOST=10.0.0.5
DB_USER=rdc_test
# PAROLU BURADA DOLDURUN (şablon github-a parolsuz gedir):
DB_PASSWORD=Buraya_parol_yazin

# ==================== LW Provider (stub mode) ====================
LW_USE_MOCK=false
LW_USE_STUB=false
LW_STUB_PORT=8090

# ==================== OTP ====================
OTP_USE_MOCK=false

# ==================== MyGov ====================
MYGOV_CLIENT_ID=82b54b39-37a4-4ccc-879b-3ac5cf43d5b4
MYGOV_REDIRECT_URI=https://webhook.site/9f74dfae-92bc-458e-a3e3-b5134a9bf8bb
MYGOV_USE_MOCK=false

# ==================== Migrations ====================
# DIQQƏT: true olanda restart-da BÜTÜN DATA SİLİNİR (yalnız dev!).
# Serverdə mütləq false qalmalıdır. Dev-də əl ilə true edin.
MIGRATIONS_DROP_RECREATE=false

# ==================== AZMK Online Lending ====================
AZMK_USE_MOCK=false
AZMK_BASE_URL=https://web.azmk.az:7077/LW_AKP/services/OnlineLendingService
AZMK_CUSTOMER_DATA_URL=https://web.azmk.az:7077/LW_AKP/services/CustomerDataService
AZMK_CUSTOMER_DATA_USE_MOCK=false
AZMK_BRANCH_CODE=HO
AZMK_PRODUCT_ID=I10
AZMK_CARD_EXPIRING=2030-01-01
# PR #349: AZMK_DISBURSEMENT_FEE silindi — disbursementFee artıq
# credit_levels.commission-dan göndərilir (ApprovedRate / 100).
AZMK_TIMEOUT_S=30
AZMK_USERNAME=ALPULAK
# PAROLU BURADA DOLDURUN (şablon github-a parolsuz gedir):
# AZMK_PASSWORD=Buraya_parol_yazin

AZMK_KYC_VERIFY_ENABLED=true

# ==================== Referal endirimi (PR #284) ====================
# Disburse success SMS-indəki endirim faizi ("X% endirim") — həm generasiya
# olunan referal kodunun discount_value-si, həm də SMS mətni bu dəyəri
# istifadə edir. Dəyişəndən sonra yenidən run-remote.sh işlədin.
# Default: 5
REFERRAL_DISCOUNT_PERCENT=5

# ==================== AZMK imza gözləmə (PR #312) ====================
# Ekspert approve → AZMK application create → pending_signature.
# Worker müştərinin imzasını bu intervalda yoxlayır (GET /application/{id}/status):
AZMK_SIGN_POLL_INTERVAL_S=300
# Müştərinin imzalama limiti (saniyə) — bitərsə müraciət avtomatik imtina edilir:
AZMK_SIGN_TIMEOUT_S=10800
CUTOFF_STOP_ON_FIRST_FAIL=true
CUTOFF_CHECKS_ENABLED=true
EMPLOYMENT_TENURE_MIN_MONTHS=1

# ==================== Loglaşdırma (PR #304) ====================
# Kənar servislərə (AZMK, LW, OTP, MyGov, SIMA, Video) gedən sorğu/cavablar
# Loki-yə yazılır (msg="external_call"). Parol/token avtomatik maskalanır.
# Söndürmək istəsəniz false edin:
EXTERNAL_REQRESP_LOG=true

# ==================== Video record ====================
VIDEO_RECORD_ENABLED=true
VIDEO_RECORD_USE_MOCK=false
VIDEO_RECORD_BASE_URL=https://videodemo.kvadrat-lab.com
VIDEO_RECORD_USERNAME=bokt
# Video parolu repo-da default var (config.go) — dəyişmək istəsəniz açın:
# VIDEO_RECORD_PASSWORD=Buraya_parol_yazin

# ==================== Ekspert iş saatları (PR #360) ====================
# Apply success ekranında mesaj saatına görə dəyişir:
# Bakı vaxtı bu aralıqdan kənar olanda (gecə 20:00-dən səhər 09:00-a qədər)
# "Ekspertimiz iş saatlarında (09:00-20:00) sizinlə əlaqə saxlayacaq" yazılır.
# Daxilində olanda adi mesaj: "Ekspertimiz sizinlə əlaqə saxlayacaq."
EXPERT_WORK_START_HOUR=9
EXPERT_WORK_END_HOUR=20
